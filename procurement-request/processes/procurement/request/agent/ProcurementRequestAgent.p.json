    }, {
      "id" : "f12",
      "type" : "ProgramInterface",
      "name" : "Parse Structured Request Agent",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "system" : "You are a procurement document extraction specialist. Extract all material procurement request fields from the provided document content.\\n\\nFields to extract:\\n- projectName\\n- projectNumberCostCenter\\n- constructionSiteDeliveryAddress\\n- requiredDeliveryDate (yyyy-MM-dd)\\n- priority (NORMAL, HIGH, URGENT, or LOW)\\n- requester\\n- orderNotes\\n- materialItems: list of items, each with:\\n  - materialDescription\\n  - standardGradeClass\\n  - quantity (number)\\n  - unit\\n  - supplier\\n  - unitPriceNet (number)\\n  - purpose\\n  - comment\\n\\nReturn a structured MaterialProcurementRequest object. Keep fields null if not present in the document.",
          "tools" : "[]",
          "resultType" : "procurement.request.model.MaterialProcurementRequest.class",
          "resultMapping" : "in.parsedDraft",
          "query" : "Extract procurement request values from this document:\\n\\n<TEXT>\\n<%= in.ocrContent %>\\n</TEXT>"
        }
      },
      "visual" : {
        "at" : { "x" : 840, "y" : 408 },
        "size" : { "width" : 176, "height" : 70 }
      },
      "boundaries" : [ {
          "id" : "f13",
          "type" : "ErrorBoundaryEvent",
          "config" : {
            "errorCode" : "ivy:error:program:exception",
            "output" : {
              "code" : [
                "ivy.log.error(\"Failed to parse procurement document: \" + error.getMessage(), error);",
                "in.parsedDraft = null;",
                "in.parseFeedback = \"Failed to parse document: \" + error.getMessage();"
              ]
            }
          },
          "visual" : {
            "at" : { "x" : 888, "y" : 445 }
