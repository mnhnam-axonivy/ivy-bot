          "map" : {
            "out.ocrContent" : "param.content",
            "out.inputStream" : "param.inputStream"
          }
        },
        "result" : {
          "params" : [
            { "name" : "parsedDraft", "type" : "procurement.request.model.MaterialProcurementRequest", "desc" : "Parsed procurement request values extracted from the document" },
            { "name" : "parseFeedback", "type" : "String", "desc" : "Parse status message for the caller" }
          ],
          "map" : {
            "result.parsedDraft" : "in.parsedDraft",
            "result.parseFeedback" : "in.parseFeedback"
          }
        }
      },
      "tags" : [
        "tool"
      ],
      "visual" : {
        "at" : { "x" : 96, "y" : 408 },
        "description" : "Performs OCR on in.inputStream, then extracts a structured MaterialProcurementRequest. No LLM argument needed â€” uses the uploaded stream directly."
      },
      "connect" : [
        { "id" : "c10", "to" : "f11" }
