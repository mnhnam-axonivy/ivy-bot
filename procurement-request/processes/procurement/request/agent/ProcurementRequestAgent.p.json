          "code" : [
            "if (in.parsedDraft == null) {",
            "  in.parseFeedback = ivy.cms.co(\"/Dialogs/procurement/request/CreateRequestDialog/ParseNoValues\");",
            "} else {",
            "  in.parseFeedback = ivy.cms.co(\"/Dialogs/procurement/request/CreateRequestDialog/ParseSuccess\");",
            "}"
